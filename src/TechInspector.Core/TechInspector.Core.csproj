<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine with no SimHub or WPF dependencies: ini model, safe writes, backups, paths.
       netstandard2.0 so the net48 plugin and the modern test project can both use it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TechInspector.Core</RootNamespace>
    <AssemblyName>TechInspector.Core</AssemblyName>
  </PropertyGroup>

  <!-- Generated by tools/build-catalog.mjs from the prototype's researched data. -->
  <ItemGroup>
    <EmbeddedResource Include="Catalog\catalog.json" LogicalName="TechInspector.Core.Catalog.catalog.json" />
    <!-- Hand-curated: the common fixes the Settings tab opens on. -->
    <EmbeddedResource Include="Catalog\goals.json" LogicalName="TechInspector.Core.Catalog.goals.json" />
  </ItemGroup>

</Project>
