<UserControl x:Class="TechInspector.Plugin.UI.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:ui="clr-namespace:TechInspector.Plugin.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- Muted text uses opacity, not a fixed colour, so SimHub's Day and Night themes both work. -->
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,0,0,0">
        <!-- SimHub shows the plugin name above the page, so only the maker line sits here. -->
        <TextBlock DockPanel.Dock="Top" Text="{SLoc TechInspector_ByMaker, 'by Simpatico Sim Shop'}" Style="{StaticResource Muted}" Margin="2,0,0,10" />

        <!-- The changes bar sits under every tab. -->
        <ui:ChangesBar x:Name="Bar" DockPanel.Dock="Bottom" />

        <styles:SHTabControl x:Name="Tabs">

            <!-- Overview: the health check. -->
            <styles:SHTabItem x:Name="OverviewItem" Header="{SLoc TechInspector_TabOverview, 'Overview'}">
                <ui:OverviewTab x:Name="OverviewView" />
            </styles:SHTabItem>

            <!-- Settings: the researched catalog over the real files. -->
            <styles:SHTabItem x:Name="SettingsItem" Header="{SLoc TechInspector_TabSettings, 'Settings'}">
                <ui:SettingsTab x:Name="SettingsView" />
            </styles:SHTabItem>

            <!-- Triple screens: the live editor and the saved-layout guard. -->
            <styles:SHTabItem x:Name="TriplesItem" Header="{SLoc TechInspector_TabTriples, 'Triple screens'}">
                <ui:TriplesTab x:Name="TriplesView" />
            </styles:SHTabItem>

            <!-- Backups: take one, import hand-made copies, compare and restore. -->
            <styles:SHTabItem x:Name="BackupsItem" Header="{SLoc TechInspector_TabBackups, 'Backups'}">
                <ui:BackupsTab x:Name="BackupsView" />
            </styles:SHTabItem>

            <!-- About: identity, what it touches, the maker, donations. -->
            <styles:SHTabItem x:Name="AboutItem" Header="{SLoc TechInspector_TabAbout, 'About'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,20" MaxWidth="900" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconpacks:PackIconMaterial Kind="ClipboardCheckOutline" Width="40" Height="40" Margin="0,2,16,0" />
                            <StackPanel>
                                <TextBlock Text="{SLoc TechInspector_Title, 'Tech Inspector'}" FontSize="18" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{SLoc TechInspector_AboutText, 'Checks and edits iRacing’s settings from inside SimHub. It explains every setting, flags values that look wrong, protects your triple-screen layout from resets, and backs up your files before every change.'}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{SLoc TechInspector_WhatItTouches, 'What it touches'}" />
                        <ItemsControl x:Name="TouchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <iconpacks:PackIconMaterial Kind="CheckBold" Foreground="#4CAF50" Width="14" Height="14" Margin="0,2,10,0" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The maker: the shop's logo on its own dark tile, so it reads on SimHub's Day and Night themes. -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{SLoc TechInspector_MadeBy, 'Made by Simpatico Sim Shop'}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FF0A0C12" CornerRadius="6" Padding="14,12" Margin="0,0,18,0" VerticalAlignment="Top"
                                    Cursor="Hand" MouseLeftButtonUp="Logo_Click" ToolTip="simpaticosims.com" AutomationProperties.Name="Simpatico Sim Shop">
                                <Image Source="/TechInspector.Plugin;component/Assets/simpatico-logo.png" Width="104" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{SLoc TechInspector_ShopText, 'Sim racing gear, for sim racers, by sim racers. Tech Inspector is free, and made by the same people.'}" />
                                <styles:SHLinkButton Click="Shop_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{SLoc TechInspector_VisitShop, 'Visit simpaticosims.com'}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{SLoc TechInspector_Source, 'Source code'}" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{SLoc TechInspector_SourceText, 'The source is on GitHub under the PolyForm Noncommercial license: free to read, build and change for non-commercial use.'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <styles:SHLinkButton Click="Source_Click" Content="{SLoc TechInspector_ViewSource, 'View on GitHub'}" Margin="0,0,18,0" />
                            <styles:SHLinkButton Click="Issues_Click" Content="{SLoc TechInspector_ReportProblem, 'Report a problem'}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{SLoc TechInspector_Support, 'Support development'}" />
                        <DockPanel>
                            <styles:SHButtonPrimary DockPanel.Dock="Right" Click="Donate_Click" Content="{SLoc TechInspector_DonateButton, 'Donate on Ko-fi'}" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                                       Text="{SLoc TechInspector_SupportText, 'Tech Inspector is free. If it’s useful to you, a donation helps keep it current with each iRacing season. Ko-fi opens in your browser.'}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,26,0,0"
                                   Text="{SLoc TechInspector_Disclaimer, 'Not affiliated with iRacing.com Motorsport Simulations or SimHub. iRacing is a trademark of iRacing.com Motorsport Simulations, LLC.'}" />
                    </StackPanel>
                </ScrollViewer>
            </styles:SHTabItem>

        </styles:SHTabControl>
    </DockPanel>
</UserControl>
