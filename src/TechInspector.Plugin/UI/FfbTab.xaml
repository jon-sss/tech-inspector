<UserControl x:Class="TechInspector.Plugin.UI.FfbTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:ui="clr-namespace:TechInspector.Plugin.UI">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/TechInspector.Plugin;component/UI/Theme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <ui:BoolToVisibility x:Key="Visible" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,14,24" MaxWidth="{StaticResource ColumnWidth}">
            <!-- What it does, the switch, and what iRacing has now. -->
            <TextBlock TextWrapping="Wrap" Margin="2,0,0,10"
                       Text="iRacing uses one wheel strength for every car. Tech Inspector remembers it per car and sets it again when you drive that car." />
            <styles:SHToggleCheckbox x:Name="PerCar" Content="Remember the wheel strength per car" Click="PerCar_Click" Margin="0,0,0,10" />
            <ItemsControl x:Name="StatusLines" Margin="2,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <iconpacks:PackIconMaterial Kind="{Binding Icon}" Foreground="{Binding IconBrush}" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Only when iRacing's keys for the strength controls can't be read from controls.cfg:
                 the same keys, pressed here once so they can be pressed for you. -->
            <StackPanel x:Name="OwnKeys" Visibility="Collapsed">
                <Grid Margin="2,8,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Strength up key" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <styles:SHButtonSecondary x:Name="UpKey" Grid.Column="1" Width="120" Margin="0,0,0,6" Click="UpKey_Click" />
                    <TextBlock Grid.Row="1" Text="Strength down key" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <styles:SHButtonSecondary x:Name="DownKey" Grid.Row="1" Grid.Column="1" Width="120" Click="DownKey_Click" />
                    <styles:SHLinkButtonSmall x:Name="ClearKeys" Grid.Row="1" Grid.Column="2" Content="Clear" Click="ClearKeys_Click" VerticalAlignment="Center" Margin="14,0,0,0"
                                              ToolTip="Forgets the keys set here." />
                </Grid>
                <TextBlock Style="{StaticResource Muted}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Click a button, then press the key you bound in iRacing, with Shift, Ctrl or Alt if you use them." />
            </StackPanel>

            <!-- The saved strengths. -->
            <ContentControl Style="{StaticResource RuleHeading}" Content="Saved per car" />
            <TextBlock x:Name="EmptyNote" Style="{StaticResource Muted}" Margin="2,0,0,0"
                       Text="No cars saved yet. Drive one and its strength is saved here." />
            <Grid x:Name="RowsHeader" Margin="12,0,12,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                <TextBlock Text="Car" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="Max force" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="Saved" Style="{StaticResource Muted}" />
            </Grid>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Car}" TextTrimming="CharacterEllipsis" />
                                    <iconpacks:PackIconMaterial Kind="Steering" Width="12" Height="12" Opacity="0.62" Margin="8,1,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Current, Converter={StaticResource Visible}}"
                                                                ToolTip="The car loaded now" Background="Transparent" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Strength}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding When}" Opacity="0.8" VerticalAlignment="Center" />
                                <styles:SHLinkButtonSmall Grid.Column="3" Content="Forget" Click="Forget_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          ToolTip="Forgets this car's strength. It's saved again the next time you drive it." />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Text="Max force is the Nm figure next to iRacing's Strength slider. It's set with your keys once you're in the car." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
