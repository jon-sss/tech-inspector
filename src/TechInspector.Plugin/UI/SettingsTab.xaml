<UserControl x:Class="TechInspector.Plugin.UI.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:ui="clr-namespace:TechInspector.Plugin.UI"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800">

    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static ui:SettingsTab.FocusSearch}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/TechInspector.Plugin;component/UI/Theme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <ui:BoolToVisibility x:Key="Visible" />
        <ui:BoolToVisibility x:Key="Hidden" Invert="True" />
        <ui:NullToVisibility x:Key="IfText" />
        <SolidColorBrush x:Key="LineBrush" Color="#8FB8D6" />

        <!-- Reset and hide: small icon buttons that appear when the row is hovered or focused. -->
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Controls, one per setting type. Every control ends on the card's right padding. ── -->
        <DataTemplate x:Key="BoolControl">
            <styles:SHToggleCheckbox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding Label}" HorizontalAlignment="Right" />
        </DataTemplate>
        <DataTemplate x:Key="EnumControl">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding IsEditable}"
                      MinWidth="150" AutomationProperties.Name="{Binding Label}" ToolTipService.IsEnabled="{Binding HasOptionsTip}" ToolTip="{Binding OptionsTip}" />
        </DataTemplate>
        <DataTemplate x:Key="NumberControl">
            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="74" TextAlignment="Right" IsEnabled="{Binding IsEditable}"
                     ui:CommitOnEnter.Enabled="True" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="NumberUnitControl">
            <!-- One field: the value, then the unit as a muted suffix inside the same border. -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource TextBoxBorderBrush}" Background="{DynamicResource ControlBackgroundBrush}" MinWidth="96">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Opacity="0.6" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="56" TextAlignment="Right" BorderThickness="0" Background="Transparent" IsEnabled="{Binding IsEditable}"
                             ui:CommitOnEnter.Enabled="True" AutomationProperties.Name="{Binding Label}" />
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TextControl">
            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="230" ui:CommitOnEnter.Enabled="True" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="ReadOnlyControl">
            <TextBlock Text="{Binding ReadOnlyText}" FontFamily="Consolas" FontSize="12.5" Opacity="0.62" ToolTip="iRacing marks this as not to be edited." />
        </DataTemplate>
        <DataTemplate x:Key="RequiredControl">
            <Border BorderBrush="#66888888" BorderThickness="1" CornerRadius="2" Padding="5,1" ToolTip="Turning this off stops every SimHub dashboard, overlay and effect for iRacing.">
                <TextBlock Text="Required by SimHub" FontSize="11" Opacity="0.7" />
            </Border>
        </DataTemplate>
        <ui:ControlTemplateSelector x:Key="Controls"
            Bool="{StaticResource BoolControl}" Enum="{StaticResource EnumControl}" Number="{StaticResource NumberControl}"
            NumberWithUnit="{StaticResource NumberUnitControl}" Text="{StaticResource TextControl}"
            ReadOnly="{StaticResource ReadOnlyControl}" Required="{StaticResource RequiredControl}" />

        <!-- ── Items inside a section card ── -->
        <DataTemplate DataType="{x:Type ui:GroupHeaderItem}">
            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Opacity="0.62" Margin="0,12,0,2" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:TierDividerItem}">
            <DockPanel Margin="0,16,0,2">
                <TextBlock Text="{Binding Title}" FontSize="12.5" Opacity="0.8" Margin="0,0,10,0" />
                <Rectangle Height="1" Fill="{StaticResource RuleBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:MoreLinkItem}">
            <styles:SHLinkButtonSmall Content="{Binding Text}" HorizontalAlignment="Left" Margin="0,10,0,2" Click="MoreLink_Click" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:SectionFootItem}">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasHidden, Converter={StaticResource Visible}}" Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"><Run Text="{Binding Hidden, Mode=OneWay}" /><Run Text=" hidden · " /></TextBlock>
                    <styles:SHLinkButtonSmall Content="Show" Click="ShowHidden_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasExpert, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"><Run Text="{Binding Expert, Mode=OneWay}" /><Run Text=" expert settings · " /></TextBlock>
                    <styles:SHLinkButtonSmall Content="Show" Click="ShowExpert_Click" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:SettingRow}">
            <Grid x:Name="RowRoot" Background="Transparent" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,9,18,9">
                    <StackPanel Orientation="Horizontal">
                        <iconpacks:PackIconMaterial x:Name="MarkDanger" Kind="AlertOctagon" Foreground="{StaticResource DangerBrush}" Width="15" Height="15" Margin="0,1,7,0" Visibility="Collapsed" ToolTip="{Binding DangerText}" />
                        <Ellipse x:Name="MarkChanged" Width="7" Height="7" Fill="{DynamicResource AccentColorBrush}" Margin="0,2,8,0" Visibility="Collapsed" ToolTip="Changed, not written" />
                        <iconpacks:PackIconMaterial x:Name="MarkUnusual" Kind="AlertCircle" Foreground="{StaticResource WarnBrush}" Width="15" Height="15" Margin="0,1,7,0" Visibility="Collapsed" ToolTip="Unusual value" />
                        <TextBlock x:Name="LabelText" FontSize="14" ui:Highlight.Text="{Binding Label}" ui:Highlight.Query="{Binding DataContext.QueryLower, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Border Visibility="{Binding IsIniOnly, Converter={StaticResource Visible}}" BorderBrush="#66888888" BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="{Binding IniOnlyTip}">
                            <TextBlock Text="INI only" FontSize="11" Opacity="0.7" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,1,0,0"
                               ui:HelpLine.Text="{Binding HelpText}" ui:HelpLine.Unusual="{Binding UnusualText}" ui:HelpLine.Was="{Binding WasText}" ui:HelpLine.Caution="{Binding CautionText}"
                               ui:HelpLine.Query="{Binding DataContext.QueryLower, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <StackPanel Visibility="{Binding DataContext.ShowIniLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding RawLine}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource LineBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding SourceText, Converter={StaticResource IfText}}" />
                    </StackPanel>
                </StackPanel>

                <!-- The pin stays in sight once pinned; reset and hide show on hover or focus. -->
                <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource RowAction}" Click="Pin_Click" ToolTip="{Binding PinTip}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Opacity="0" AutomationProperties.Name="{Binding PinTip}">
                    <iconpacks:PackIconMaterial x:Name="PinIcon" Kind="PinOutline" Width="15" Height="15" Opacity="0.8" />
                </Button>
                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Margin="0,0,38,0">
                    <Button Style="{StaticResource RowAction}" Click="Reset_Click" ToolTip="{Binding ResetTip}" Visibility="{Binding CanReset, Converter={StaticResource Visible}}" AutomationProperties.Name="Reset to default">
                        <iconpacks:PackIconMaterial Kind="Restore" Width="15" Height="15" Opacity="0.8" />
                    </Button>
                    <Button Style="{StaticResource RowAction}" Click="Hide_Click" ToolTip="Hide this setting. Show it again from the bottom of the section." Visibility="{Binding CanHide, Converter={StaticResource Visible}}" AutomationProperties.Name="Hide setting">
                        <iconpacks:PackIconMaterial Kind="EyeOffOutline" Width="15" Height="15" Opacity="0.8" />
                    </Button>
                </StackPanel>

                <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplateSelector="{StaticResource Controls}" VerticalAlignment="Center" HorizontalAlignment="Right" Focusable="False" />

                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="{StaticResource RuleBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Marker}" Value="Danger"><Setter TargetName="MarkDanger" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Marker}" Value="Changed"><Setter TargetName="MarkChanged" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Marker}" Value="Unusual"><Setter TargetName="MarkUnusual" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsInert}" Value="True"><Setter TargetName="LabelText" Property="Opacity" Value="0.45" /></DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Actions" Property="Opacity" Value="1" /><Setter TargetName="PinButton" Property="Opacity" Value="1" /></Trigger>
                <Trigger SourceName="RowRoot" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Actions" Property="Opacity" Value="1" /><Setter TargetName="PinButton" Property="Opacity" Value="1" /></Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter TargetName="PinButton" Property="Opacity" Value="1" /><Setter TargetName="PinIcon" Property="Kind" Value="Pin" /><Setter TargetName="PinIcon" Property="Foreground" Value="{DynamicResource AccentColorBrush}" /><Setter TargetName="PinIcon" Property="Opacity" Value="1" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The centred column: the toolbar across the top, then the rail beside the pane. -->
    <Grid MaxWidth="{StaticResource ColumnWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: search on the left; the graphics file and the View menu on the right. -->
        <DockPanel Margin="0,4,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Graphics file" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ModeBox" MinWidth="120" SelectionChanged="Mode_Changed" AutomationProperties.Name="Graphics file" />
                <styles:SHButtonSecondary x:Name="ViewButton" Margin="10,0,0,0" Click="View_Click" ToolTip="More settings, expert settings, ini lines, and the files themselves">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="View" />
                        <iconpacks:PackIconMaterial Kind="ChevronDown" Width="10" Height="10" Margin="7,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </styles:SHButtonSecondary>
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="420" HorizontalAlignment="Left" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     mah:TextBoxHelper.Watermark="Search all settings" mah:TextBoxHelper.ClearTextButton="True"
                     AutomationProperties.Name="Search all settings" KeyDown="Search_KeyDown" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The rail: common fixes, then the lists. Headings can't be selected. -->
            <ListBox x:Name="Rail" ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionChanged="Rail_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Settings, by what you want to change">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Background="Transparent" Margin="0,0,0,1">
                                        <Border x:Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="3" Opacity="0" />
                                        <Border x:Name="Sel" Background="{DynamicResource AccentColorBrush}" CornerRadius="3" Opacity="0" />
                                        <Border x:Name="Focus" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="3" Opacity="0" />
                                        <ContentPresenter Margin="10,7,10,7" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsEnabled" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                        </MultiTrigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="Opacity" Value="0.32" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type ui:NavHeading}">
                        <ContentControl x:Name="Heading" Style="{StaticResource RuleHeading}" Content="{Binding Title}" Margin="-10,18,-10,0" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="Heading" Property="Margin" Value="-10,0,-10,0" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <!-- Common fixes and lists: the name, a count for lists, and the checkpoint mark. -->
                    <DataTemplate DataType="{x:Type ui:NavItem}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="16" Margin="8,0,0,0" Background="Transparent" ToolTip="{Binding MarkTip}">
                                <iconpacks:PackIconMaterial x:Name="Tick" Kind="Check" Width="12" Height="12" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <iconpacks:PackIconMaterial x:Name="Unusual" Kind="AlertCircle" Foreground="{StaticResource WarnBrush}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Ellipse x:Name="Changed" Width="7" Height="7" Fill="{DynamicResource AccentColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <iconpacks:PackIconMaterial x:Name="Link" Kind="ArrowRight" Width="12" Height="12" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Mark}" Value="Tick"><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Mark}" Value="Unusual"><Setter TargetName="Unusual" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Mark}" Value="Changed"><Setter TargetName="Changed" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Mark}" Value="Link"><Setter TargetName="Link" Property="Visibility" Value="Visible" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,14,28">

                    <!-- A common fix: its title, one line, and only its settings. -->
                    <StackPanel Visibility="{Binding ShowingGoal, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Goal.Title}" FontSize="19" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Goal.Summary}" Style="{StaticResource Muted}" FontSize="13" />
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,2,16,2" Visibility="{Binding Goal.HasRows, Converter={StaticResource Visible}}">
                            <ItemsControl ItemsSource="{Binding Goal.Rows}" Focusable="False" />
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding Goal.HasRows, Converter={StaticResource Hidden}}">
                            <StackPanel Orientation="Horizontal">
                                <iconpacks:PackIconMaterial Kind="PinOutline" Width="16" Height="16" Opacity="0.6" Margin="0,1,12,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Goal.EmptyText}" Style="{StaticResource Muted}" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="2,12,0,0" Visibility="{Binding Goal.HasSections, Converter={StaticResource Visible}}">
                            <TextBlock Text="Everything in" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Goal.Sections}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <styles:SHLinkButtonSmall Content="{Binding Name}" Click="Section_Click" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- A list or a search: the matching sections, grouped under rule headings by what they're for. -->
                    <StackPanel Visibility="{Binding ShowingList, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding ListTitle}" FontSize="19" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <styles:SHLinkButtonSmall Content="{Binding ShowMoreText}" Click="ShowMore_Click" Margin="0,0,16,0" Visibility="{Binding CanShowMore, Converter={StaticResource Visible}}" />
                            <styles:SHLinkButtonSmall Content="{Binding ShowExpertText}" Click="ShowExpert_Click" Visibility="{Binding CanShowExpert, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,24,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Areas}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ContentControl Style="{StaticResource RuleHeading}" Content="{Binding Title}" Margin="0,24,0,8" />
                                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <styles:SHExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6" ui:InstantCollapse.Enabled="True">
                                                        <styles:SHExpander.Header>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding RawName}" FontFamily="Consolas" FontSize="12" Opacity="0.55" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding DataContext.ShowIniLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                                                                <TextBlock DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <Run Text="{Binding ChangedText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding CountText, Mode=OneWay}" Foreground="Gray" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </styles:SHExpander.Header>
                                                        <ItemsControl ItemsSource="{Binding Items}" Margin="34,0,14,8" Focusable="False" />
                                                    </styles:SHExpander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
