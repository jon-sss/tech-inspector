<UserControl x:Class="TechInspector.Plugin.UI.ChangesBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TechInspector.Plugin;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Pinned to the bottom of the page on every tab: SimHub's own sticky-bar colour. -->
    <Border Background="{DynamicResource SHStickyBarBackgroundBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <!-- Review: exactly which lines change. -->
            <StackPanel x:Name="ReviewPanel" Visibility="Collapsed" Margin="16,12,16,4">
                <Grid Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="File" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="1" Text="Setting" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="2" Text="Now" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="3" Text="New" Style="{StaticResource Muted}" />
                </Grid>
                <ItemsControl x:Name="ReviewList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" Padding="10,6" Margin="0,0,0,3" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding File}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Setting}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Now}" Opacity="0.7" />
                                    <TextBlock Grid.Column="3" Text="{Binding New}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Only these lines change. Everything else in the files stays as it is." />
            </StackPanel>

            <DockPanel Margin="16,9">
                <StackPanel x:Name="BarButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <styles:SHButtonSecondary x:Name="DiscardButton" Content="Discard" Click="Discard_Click" Margin="0,0,8,0" />
                    <styles:SHButtonPrimary x:Name="WriteButton" Content="Back up and write" Click="Write_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="BarDot" Width="8" Height="8" Fill="{DynamicResource AccentColorBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <iconpacks:PackIconMaterial x:Name="BarDone" Kind="CheckCircle" Foreground="{StaticResource OkBrush}" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" />
                    <iconpacks:PackIconMaterial x:Name="BarError" Kind="CloseCircle" Foreground="{StaticResource DangerBrush}" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarNote" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <styles:SHLinkButtonSmall x:Name="ReviewLink" Content="Review" Click="Review_Click" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <styles:SHLinkButtonSmall x:Name="CancelLink" Content="Cancel" Click="CancelQueue_Click" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <styles:SHLinkButtonSmall x:Name="UndoLink" Content="Undo" Click="Undo_Click" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
